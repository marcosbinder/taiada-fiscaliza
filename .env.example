# ==============================================================================
# TAIADA FISCALIZA ("Cobra, Taiada!") - Variáveis de Ambiente de Exemplo
# Caçapava - SP (IBGE: 3508504) | Paleta: #15301d / #347947
# Copie este arquivo para .env: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Configurações do Servidor HTTP
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# Persistência de Dados e Armazenamento Local
# ------------------------------------------------------------------------------
# Caminho para o banco de dados SQLite (modo WAL ativado automaticamente)
DATABASE_PATH=./data/taiada-fiscaliza.db

# Diretório para fotos sanitizadas (.webp sem metadados EXIF pessoais)
UPLOADS_DIR=./data/uploads

# ------------------------------------------------------------------------------
# Segurança Zero-Auth (Criptografia e Assinatura de Cookies)
# ------------------------------------------------------------------------------
# Segredo para assinatura HMAC-SHA256 do cookie taiada_device_token.
# Em desenvolvimento, um segredo padrão é aceito. Em produção, DEFINA UMA CHAVE FORTE (mínimo 32 caracteres).
DEVICE_SECRET=dev-secret-device-hmac-cacapava-2026-min32chars

# Token de autorização para o painel /admin e rotas de moderação/expurgo.
# Deve ser enviado no cabeçalho: Authorization: Bearer <ADMIN_TOKEN>
ADMIN_TOKEN=cacapava-admin-secret-token-change-in-prod

# ------------------------------------------------------------------------------
# Identidade Visual e Configuração de Marca
# ------------------------------------------------------------------------------
# Modo padrão da marca:
# - 'institucional': "Taiada Fiscaliza" (subtítulo: "Cobra, Taiada! • Zeladoria Colaborativa de Caçapava")
# - 'imperativo': "Cobra, Taiada!" (subtítulo: "Taiada Fiscaliza • Mapa Cívico de Caçapava")
VITE_APP_BRAND_MODE=institucional

# URL pública da aplicação (usada na geração de metatags OpenGraph para WhatsApp)
PUBLIC_BASE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Integrações Externas Opcionais
# ------------------------------------------------------------------------------
# URL de Webhook (Discord / Telegram) para alertas em tempo real de moderação (opcional)
WEBHOOK_URL=
